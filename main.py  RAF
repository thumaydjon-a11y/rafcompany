@app.get("/products")
def get_products():
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM products")
    products = [dict(row) for row in cursor.fetchall()]
    conn.close()
    return {"products": products}

from pydantic import BaseModel
class ProductCreate(BaseModel):
    name: str
    category: str
    price: float
    stock: int
    image_url: str = ""
    description: str = ""

@app.post("/products")
def add_product(p: ProductCreate):
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("INSERT INTO products (name, category, price, stock, image_url, description) VALUES (?, ?, ?, ?, ?, ?)", (p.name, p.category, p.price, p.stock, p.image_url, p.description))
    conn.commit()
    conn.close()
    return {"message": "OK"}

